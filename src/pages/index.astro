---
import { Image } from 'astro:assets'
import SiteLayout from '../layouts/SiteLayout.astro'
import ProjectArt from '../components/site/ProjectArt.astro'
import ProjectCard from '../components/motion/ProjectCard.jsx'
import { projects } from '../data/projects'
import { profile, rotating, statement, statementAccent, capabilities, route, credentials } from '../data/site'
import { GROUPS } from '../scripts/site-orbit.js'
import { getImage } from 'astro:assets'
import portrait from '../assets/amey-portrait-bw.png'
const lensPhoto = await getImage({ src: portrait, width: 1200, format: 'webp', quality: 78 })

const dl = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14" /></svg>'
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>'
const words = statement.split(' ')
const isAccent = (w) => statementAccent.some((a) => w.toLowerCase().startsWith(a))
const pad = (n) => String(n).padStart(2, '0')
const capArt = [
  '<rect x="22" y="12" width="156" height="96" rx="8"/><path d="M22 34H178"/><circle cx="36" cy="23" r="2.5"/><circle cx="46" cy="23" r="2.5"/><rect x="36" y="46" width="62" height="48" rx="4"/><path d="M110 50H164M110 64H150M110 78H164M110 92H138"/>',
  '<rect x="40" y="12" width="120" height="26" rx="5"/><rect x="40" y="47" width="120" height="26" rx="5"/><rect x="40" y="82" width="120" height="26" rx="5"/><circle cx="54" cy="25" r="3"/><circle cx="54" cy="60" r="3"/><circle cx="54" cy="95" r="3"/><path d="M110 25H146M110 60H146M110 95H146"/>',
  '<ellipse cx="100" cy="26" rx="52" ry="14"/><path d="M48 26V90C48 98 71 104 100 104S152 98 152 90V26"/><path d="M48 58C48 66 71 72 100 72S152 66 152 58"/>',
  '<circle cx="28" cy="60" r="12"/><rect x="78" y="38" width="44" height="44" rx="6"/><circle cx="172" cy="60" r="12"/><path d="M40 60H78M122 60H160M150 52l10 8-10 8M68 52l10 8-10 8"/><path d="M92 52H108M92 60H108M92 68H108"/>',
  '<path d="M30 40V22H48M152 22H170V40M170 80V98H152M48 98H30V80"/><circle cx="100" cy="60" r="20"/><path d="M100 30V50M100 70V90M70 60H90M110 60H130"/>',
  '<circle cx="34" cy="28" r="6"/><circle cx="34" cy="60" r="6"/><circle cx="34" cy="92" r="6"/><circle cx="100" cy="18" r="6"/><circle cx="100" cy="46" r="6"/><circle cx="100" cy="74" r="6"/><circle cx="100" cy="102" r="6"/><circle cx="166" cy="44" r="6"/><circle cx="166" cy="76" r="6"/><path d="M34 28L100 18M34 28L100 46M34 60L100 46M34 60L100 74M34 92L100 74M34 92L100 102M100 18L166 44M100 46L166 44M100 46L166 76M100 74L166 76M100 102L166 76"/>',
]
const capTheme = ['t-verm', 't-cobalt', 't-ink', 't-bone', 't-verm', 't-cobalt']
const workTheme = ['t-verm', 't-cobalt', 't-bone']
const workColor = [['#0E2B23', '#EEF5F0'], ['#2A1840', '#F6EEFB'], ['#EDE6D6', '#1B1A17']]
---
<SiteLayout>
  <main id="main">
    <!-- ===================== HERO: a WebGL scene scrubbed by scroll ===================== -->
    <section class="hero" id="top" aria-labelledby="hero-name">
      <div class="hero__stage">
        <canvas class="hero__gl" aria-hidden="true"></canvas>

        <div class="hero__copy">
          <p class="hero__kicker mono">Full-stack developer · AI/ML engineer</p>
          <h1 id="hero-name" class="hero__title" aria-label="From raw data to working software.">
            <span class="hl" aria-hidden="true"><span class="hl__in">From raw data</span></span>
            <span class="hl" aria-hidden="true"><span class="hl__in">to <em>working</em></span></span>
            <span class="hl" aria-hidden="true"><span class="hl__in">software<b>.</b></span></span>
          </h1>
          <p class="hero__lede">I’m Amey Shelar. I build the interface, the services and the model behind it, so a rough idea becomes a product people can use.</p>
          <div class="hero__actions">
            <a class="hero__link" href="#work" data-magnetic><span>See selected work</span><Fragment set:html={arrow} /></a>
            <a class="hero__link hero__link--quiet" href="#contact"><span>Get in touch</span></a>
          </div>
        </div>

        <p class="hero__cap" aria-hidden="true">
          <span data-cap="0"><b>01 / Interface</b>The part people touch, designed to stay clear when the data gets dense.</span>
          <span data-cap="1"><b>02 / Logic</b>Services, authentication and pipelines that keep it dependable.</span>
          <span data-cap="2"><b>03 / Intelligence</b>Models and computer vision that make the product smarter.</span>
        </p>

        <div class="hero__final" aria-hidden="true">
          <p class="mono">Amey Shelar / 2026</p>
          <h2 class="hero__fh">Built end <em>to end</em>.</h2>
          <p class="hero__fs">Interface, services and the model behind them. The work is next.</p>
        </div>

        <div class="hero__rail mono" aria-hidden="true">
          <span class="hero__railn">01</span><i class="hero__railbar"></i><span>Scroll to explore</span>
          <span class="hero__railline"><i></i></span>
          <span class="hero__steps"><em>Interface</em><em>Logic</em><em>Intelligence</em><em>Product</em></span>
        </div>
      </div>
    </section>

    <!-- ===================== WORK: stacked panels ===================== -->
    <section class="work t-ink sheet" id="work" aria-labelledby="work-title">
      <div class="work__head">
        <h2 id="work-title" class="wide">Selected<br />work</h2>
        <p>Three projects, each connecting an interface, a backend and something smarter underneath. Open one for the full case study.</p>
      </div>
      <div class="deck">
        {projects.map((p, i) => (
          <ProjectCard
            client:load
            index={i}
            total={projects.length}
            slug={p.slug}
            name={p.name}
            kind={p.kind}
            discipline={p.discipline}
            title={p.title}
            intro={p.intro}
            tools={p.tools}
            theme={workTheme[i % workTheme.length]}
            wipeBg={workColor[i % workColor.length][0]}
            wipeFg={workColor[i % workColor.length][1]}
          >
            <ProjectArt kind={p.kind} />
          </ProjectCard>
        ))}
      </div>
      <a class="pill github" href={profile.github} target="_blank" rel="noreferrer" data-magnetic><span>More on GitHub</span><Fragment set:html={arrow} /></a>
    </section>

    <!-- ===================== TICKER ===================== -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => (
          <div class="ticker__set">
            {['React', 'Next.js', 'TypeScript', 'Node.js', 'FastAPI', 'PostgreSQL', 'MongoDB', 'Supabase', 'Python', 'OpenCV', 'YOLO', 'LangChain', 'Hugging Face', 'Docker'].map((t) => <span><i></i>{t}</span>)}
          </div>
        ))}
      </div>
    </div>

    <!-- ===================== PORTRAIT: the second section ===================== -->
    <section class="pic t-cobalt" id="portrait" aria-labelledby="pic-title">
      <div class="pic__pin">
        <div class="pic__rows" aria-hidden="true">
          <p class="pic__row pic__row--a"><span>Developer ✦ Engineer ✦ Developer ✦ Engineer ✦ Developer ✦ Engineer ✦ </span></p>
          <p class="pic__row pic__row--b"><span>Builder ✦ Thinker ✦ Builder ✦ Thinker ✦ Builder ✦ Thinker ✦ Builder ✦ Thinker ✦ </span></p>
        </div>
        <figure class="pic__frame">
          <Image src={portrait} alt="Black-and-white portrait of Amey Shelar in sunglasses and a dark T-shirt, looking to the right" widths={[600, 900, 1254]} sizes="(max-width: 800px) 90vw, 40vw" format="webp" quality={82} loading="lazy" />
          <span class="pic__corner pic__corner--a" aria-hidden="true"></span><span class="pic__corner pic__corner--b" aria-hidden="true"></span>
        </figure>
        <svg class="pic__badge badge" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="badge-path-2" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
          <text><textPath href="#badge-path-2" textLength="478" lengthAdjust="spacing">Let’s build ✦ something useful ✦</textPath></text>
          <circle cx="100" cy="100" r="6" />
        </svg>
        <ul class="pic__chips" aria-hidden="true">
          <li style="--x:8%;--y:18%" data-speed="-0.5">React</li>
          <li style="--x:78%;--y:12%" data-speed="0.4">Python</li>
          <li style="--x:40%;--y:30%" data-speed="0.3">OpenCV</li>
          <li style="--x:88%;--y:46%" data-speed="-0.4">Node.js</li>
          <li style="--x:34%;--y:66%" data-speed="-0.3">PostgreSQL</li>
          <li style="--x:66%;--y:62%" data-speed="0.5">YOLO</li>
        </ul>
        <div class="pic__copy">
          <h2 id="pic-title" class="wide wide--sm">Hello,<br />I’m Amey.</h2>
          <p>Software developer. Previously worked as an intern at BARC and IIT Bombay.</p>
        </div>
        <dl class="pic__stats">
          <div><dt>Internships</dt><dd data-count="4">04</dd></div>
          <div><dt>Projects</dt><dd data-count="15" data-suffix="+">15+</dd></div>
          <div><dt>Tools</dt><dd data-count="33">33</dd></div>
          <div><dt>Credentials</dt><dd data-count="15" data-suffix="+">15+</dd></div>
        </dl>
      </div>
    </section>

    <!-- ===================== LENS: the photo shows through the words ===================== -->
    <section class="lens" aria-label="What I am" style={`--photo:url(${lensPhoto.src})`}>
      <div class="lens__mask">
      <p class="lens__word" data-lens>Full</p>
      <p class="lens__word lens__word--r" data-lens>Stack</p>
      <p class="lens__word" data-lens>AI / ML</p>
      <p class="lens__word lens__word--r" data-lens>Engineer</p>
    </div>
    </section>

    <!-- ===================== SIGNAL: noise resolves as you scroll ===================== -->
    <section class="signal" aria-label="Noise to signal">
      <canvas class="signal__cv" aria-hidden="true"></canvas>
      <p class="signal__lab mono" aria-hidden="true"><span>Noise</span><span>Signal</span></p>
    </section>

    <!-- ===================== STATEMENT: words fill in, a highlighter wipes under the key ones ===================== -->
    <section class="about t-bone sheet" id="about" aria-label="About">
      <svg class="about__star" viewBox="0 0 100 100" aria-hidden="true"><path d="M50 0C54 30 70 46 100 50C70 54 54 70 50 100C46 70 30 54 0 50C30 46 46 30 50 0Z" /></svg>
      <p class="denoise" data-denoise>
        {words.map((w) => <span class:list={['w', { 'w--accent': isAccent(w) }]}>{w} </span>)}
      </p>
      <div class="about__foot">
        <p>Computer Engineering, Xavier Institute of Engineering, 2026. Research intern at IIT Bombay.</p>
        <div class="about__btns">
          <a class="pill" href="#work" data-magnetic><span>See the work</span><Fragment set:html={arrow} /></a>
          <a class="pill pill--accent" href={profile.resume} download="Amey-Shelar-Resume.pdf" data-magnetic><span>Download resume</span><Fragment set:html={dl} /></a>
        </div>
      </div>
    </section>

    <!-- ===================== CAPABILITIES: a pinned horizontal rail of cards ===================== -->
    <section class="caps t-butter sheet" id="build" aria-labelledby="caps-title">
      <div class="caps__pin">
        <div class="caps__head">
          <h2 id="caps-title" class="wide">What I<br />build</h2>
          <p class="caps__lede">From the first screen to the model behind it. Six things I can take from a blank page to production.</p>
        </div>
        <div class="caps__viewport">
          <ol class="caps__track">
            {capabilities.map((c, i) => (
              <li class={`ccard ${capTheme[i % capTheme.length]}`}>
                <p class="ccard__num mono">{pad(i + 1)} / {pad(capabilities.length)}</p>
                <svg class="ccard__art" viewBox="0 0 200 120" aria-hidden="true" set:html={capArt[i]} />
                <h3 class="ccard__name">{c.name}</h3>
                <p class="ccard__detail">{c.detail}</p>
                <ul class="tags">{c.tools.map((t) => <li>{t}</li>)}</ul>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ===================== EXPERIENCE: the route (kept from the earlier site) ===================== -->
    <section class="exp t-verm" id="experience" aria-labelledby="exp-title">
      <div class="exp__pin">
        <div class="exp__head">
          <h2 id="exp-title" class="wide">Journey<br />so far</h2>
          <p>Internships and study, plotted as one journey. Scroll to ride it.</p>
        </div>
        <div class="map">
          <div class="map__world">
            <canvas class="map__terrain" aria-hidden="true"></canvas>
            <svg class="route__svg" aria-hidden="true"><path class="route__ghost" /><path class="route__line" /><path class="route__trail" /></svg>
            <div class="route__car" aria-hidden="true"><i></i></div>
            <ol class="route__stops">
              {route.map((s) => (
                <li class:list={['stop', { 'stop--now': s.now }]} data-at={s.at}>
                  <span class="stop__pin" aria-hidden="true"></span><span class="stop__stem" aria-hidden="true"></span>
                  <div class="stop__card">
                    <p class="stop__when mono"><time>{s.when}</time>{s.now && <span>Now</span>}</p>
                    <h3>{s.place}</h3>
                    <p class="stop__role">{s.role}</p>
                    <p class="stop__text">{s.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <div class="map__mini" aria-hidden="true"><svg><path class="mini__route" /><g class="mini__stops"></g><rect class="mini__view" /></svg></div>
        <div class="hud mono" aria-hidden="true">
          <span>Route <b class="hud__pct">0%</b></span>
          <span>Stop <b class="hud__stop">00 / 04</b></span>
          <span>Bearing <b class="hud__brg">000°</b></span>
          <span>Grid <b class="hud__grid">A1</b></span>
        </div>
      </div>
    </section>

    <!-- ===================== STACK: the globe (kept from the earlier site) ===================== -->
    <section class="stack t-ink sheet" id="stack" aria-labelledby="stack-title">
      <div class="stack__copy">
        <h2 id="stack-title" class="wide">Tools in<br />orbit</h2>
        <p class="stack__lede">Everything I build with, on one sphere. Drag to turn it, pick a group, or select a tool to see where I’ve used it.</p>
        <div class="filters" role="group" aria-label="Filter tools by group">
          <button type="button" class="filter" aria-pressed="true" data-group="">All</button>
          {Object.entries(GROUPS).map(([k, v]) => <button type="button" class="filter" aria-pressed="false" data-group={k}>{v}</button>)}
        </div>
        <div class="stack__detail" aria-live="polite">
          <p class="stack__group mono">Frontend</p>
          <p class="stack__tool">React</p>
          <p class="stack__use">Default for product UI. The VPN dashboard and the retail platform.</p>
        </div>
      </div>
      <div class="orbit" data-cursor="Drag"><div class="orbit__stage"></div></div>
    </section>

    <!-- ===================== CREDENTIALS ===================== -->
    <section class="creds t-butter sheet" id="credentials" aria-labelledby="creds-title">
      <h2 id="creds-title" class="wide wide--sm">Credentials</h2>
      <ul class="creds__list">
        {credentials.map((c) => (
          <li class="cred">
            <span class="cred__mark">{c.mark}</span>
            <span class="cred__title">{c.title}</span>
            <span class="cred__by">{c.by}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ===================== CONTACT ===================== -->
    <section class="contact t-ink sheet" id="contact" aria-labelledby="contact-title">
      <div class="shout" aria-hidden="true">
        <div class="shout__track">
          {[0, 1].map(() => (
            <div class="shout__set"><span>Say hello</span><i>✦</i><b>Say hello</b><i>✦</i><span>Let’s build</span><i>✦</i><b>Let’s build</b><i>✦</i></div>
          ))}
        </div>
      </div>
      <h2 id="contact-title" class="contact__title wide" aria-label="Have something to build?"><span class="ln"><span class="ln__in">Have something</span></span><span class="ln"><span class="ln__in">to build?</span></span></h2>
      <div class="contact__row">
        <p>Freelance build, a full-time role or a quick question. Write to me and I’ll reply by email.</p>
        <div class="contact__actions">
          <a class="mail" href={`mailto:${profile.email}`} data-magnetic data-cursor="Write">{profile.email}<Fragment set:html={arrow} /></a>
          <a class="pill pill--accent" href={profile.resume} download="Amey-Shelar-Resume.pdf"><span>Download resume</span><Fragment set:html={dl} /></a>
          <button type="button" class="pill copy" data-email={profile.email}><span class="copy__state" aria-live="polite">Copy email</span></button>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
