---
import { education } from '../scripts/data.js'
---
<section class="words sec sec--accent" id="education" data-rail="Education">
  <div class="words__bg" aria-hidden="true"><div class="words__marq"><span>Education</span><span>Education</span><span>Education</span><span>Education</span></div></div>
  <div class="words__stage">
    <h2 class="words__heading">Education</h2>
    <div class="deck" data-cursor="Drag" aria-label="Education cards">
      {education.map((item) => (
        <article class="card">
          <span class="card__year">{item.year}</span>
          <h3 class="card__text">{item.institution}</h3>
          <div class="card__qualification"><span class="av" aria-hidden="true">{item.initials}</span><span><b>{item.qualification}</b>{item.detail}</span></div>
        </article>
      ))}
    </div>
    <div class="words__nav">
      <button class="rbtn" data-dir="-1" aria-label="Previous education" data-cursor="hover" data-magnetic>←</button>
      <span class="words__count" aria-live="polite"><b>1</b> / {education.length}</span>
      <button class="rbtn" data-dir="1" aria-label="Next education" data-cursor="hover" data-magnetic>→</button>
      <span class="words__hint">Drag to explore</span>
    </div>
  </div>
</section>
