  <path d="M0 20h9" stroke="var(--red)" stroke-width="5" />
  <path d="M31 20h9" stroke="var(--amber)" stroke-width="5" />
  <path d="M20 0v9" stroke="var(--blue)" stroke-width="5" />
  <path d="M20 31v9" stroke="var(--green)" stroke-width="5" />
  <circle cx="20" cy="20" r="10" fill="var(--enamel)" stroke="currentColor" stroke-width="4" />
</svg>
