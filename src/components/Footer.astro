---
import { profile } from '../scripts/data.js'
---
    <!-- ============ FOOTER CURTAIN: revealed as the page lifts ============ -->
    <footer class="foot" aria-label="Footer">
      <div class="foot__meta">
        <div><span class="k">Focus</span><p>Software engineering, full stack, backend &amp; AI</p></div>
        <div><span class="k">Elsewhere</span><p><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" data-cursor="hover">LinkedIn</a>, <a href={profile.github} target="_blank" rel="noopener noreferrer" data-cursor="hover">GitHub</a>, <a href={profile.resume} download data-cursor="hover">Resume</a></p></div>
        <div><span class="k">Local time</span><p>India · <span data-clock-full>--:--:--</span> IST</p></div>
      </div>
      <div class="foot__play" aria-hidden="true"></div>
      <div class="foot__bottom">
        <div class="foot__name" aria-hidden="true">Amey</div>
        <div class="foot__row"><span>© {new Date().getFullYear()} Amey Shelar.</span><button class="to-top" data-cursor="hover" data-magnetic><span>Back to top ↑</span></button></div>
      </div>
    </footer>
