---
      <!-- ============ PROCESS: particles change shape ============ -->
      <section class="process sec sec--dark" id="process" data-rail="Process">
        <div class="process__pin">
          <canvas class="process__cv" aria-hidden="true"></canvas>
          <div class="process__ui">
            <p class="eyebrow">Process</p>
            <div class="process__num" aria-hidden="true"><span class="odo odo--big" data-odo="01"></span></div>
            <div class="process__steps">
              <article class="pstep"><span class="pstep__n">Phase 01 · Scatter</span><h3>Discover</h3><p>Interviews, audits and a week inside your product. I leave with a clear problem, not a mood board.</p></article>
              <article class="pstep"><span class="pstep__n">Phase 02 · Align</span><h3>Define</h3><p>Flows, structure and a written design principle for every decision we will argue about later.</p></article>
              <article class="pstep"><span class="pstep__n">Phase 03 · Form</span><h3>Design</h3><p>High-fidelity screens and real prototypes, tested with people who have never heard of you.</p></article>
              <article class="pstep"><span class="pstep__n">Phase 04 · Ship</span><h3>Develop</h3><p>Production front-end, motion and handover docs. I stay on until it ships and a little after.</p></article>
            </div>
          </div>
          <div class="process__hud" aria-hidden="true">
            <span>Phase <b class="ph-n">01</b> / 04</span>
            <span>Points <b class="ph-p">0</b></span>
            <span>State <b class="ph-s">Scatter</b></span>
          </div>
          <ol class="process__ticks" aria-hidden="true"><li></li><li></li><li></li><li></li></ol>
        </div>
      </section>
