---
import { profile } from '../scripts/data.js'
---
      <!-- ============ ABOUT: words light up, pills open ============ -->
      <section class="about sec" id="about" data-rail="About">
        <div class="about__pin">
          <p class="eyebrow">About</p>
          <p class="about__lead" data-fill>I’m Amey Shelar. <span class="pill" data-pill="flow"></span> My Computer Engineering background connects full-stack software, <span class="pill" data-pill="tangle"></span> data and AI. I build useful systems, <span class="pill" data-pill="dots"></span> from the database to the interface.</p>
        </div>
        <div class="about__stats">
          <div class="stat"><span class="odo" data-odo="3"></span><span class="stat__l">Internships</span></div>
          <div class="stat"><span class="odo" data-odo="3"></span><span class="stat__l">Featured projects</span></div>
          <div class="stat"><span class="odo" data-odo="4"></span><span class="stat__l">Certifications &amp; appreciations</span></div>
          <div class="stat"><span class="odo" data-odo="2026"></span><span class="stat__l">B.E. Computer Engineering</span></div>
        </div>
        <div class="about__cols">
          <figure class="portrait">
            <div class="portrait__frame">
              <span class="portrait__ph" aria-hidden="true">AS</span>
            </div>
            <figcaption class="k">Amey Shelar — Software &amp; AI</figcaption>
          </figure>
          <div><span class="k">Focus</span><p>Full-stack applications, backend APIs, database-backed dashboards and practical AI systems.</p></div>
          <div><span class="k">Currently</span><p>Research intern at IIT Bombay, working on the industry project Dhatuverse.</p></div>
          <div><span class="k">Background</span><p>Computer Engineering at Xavier Institute of Engineering, class of 2026.</p><a class="resume-link" href={profile.resume} download>Download resume ↗</a></div>
        </div>
        <div class="marquee" aria-hidden="true">
          <div class="marquee__row"><span>Full stack</span><i>✺</i><span>Backend APIs</span><i>✺</i><span>Data engineering</span><i>✺</i><span>Computer vision</span><i>✺</i><span>AI systems</span><i>✺</i></div>
        </div>
      </section>
