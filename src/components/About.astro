      <!-- ============ ABOUT: words light up, pills open ============ -->
      <section class="about sec" id="about" data-rail="About">
        <div class="about__pin">
          <p class="eyebrow">About</p>
          <p class="about__lead" data-fill>I’m Amey. <span class="pill" data-pill="flow"></span> For seven years I’ve helped founders and studios turn complicated <span class="pill" data-pill="tangle"></span> ideas into products that feel obvious, <span class="pill" data-pill="dots"></span> then built them with the same care in code.</p>
        </div>
        <div class="about__stats">
          <div class="stat"><span class="odo" data-odo="7"></span><span class="stat__l">Years in practice</span></div>
          <div class="stat"><span class="odo" data-odo="42"></span><span class="stat__l">Launches shipped</span></div>
          <div class="stat"><span class="odo" data-odo="9"></span><span class="stat__l">Industries</span></div>
          <div class="stat"><span class="odo" data-odo="4"></span><span class="stat__l">Awwwards Sites of the Day</span></div>
        </div>
        <div class="about__cols">
          <figure class="portrait">
            <div class="portrait__frame">
              <span class="portrait__ph" aria-hidden="true">A</span>
              <img src="/amey.jpg" alt="Portrait of Amey" width="800" height="1000" loading="lazy" decoding="async" onerror="this.remove()" />
            </div>
            <figcaption class="k">Amey — Designer &amp; developer</figcaption>
          </figure>
          <div><span class="k">Focus</span><p>Product design, design systems and interactive websites for early-stage and growing teams.</p></div>
          <div><span class="k">Approach</span><p>Small teams, short loops, real prototypes. I design in the browser as soon as the idea can survive it.</p></div>
          <div><span class="k">Outside work</span><p>Film photography, mechanical keyboards and too many type specimens.</p></div>
        </div>
        <div class="marquee" aria-hidden="true">
          <div class="marquee__row"><span>Product design</span><i>✺</i><span>Design systems</span><i>✺</i><span>Creative development</span><i>✺</i><span>Interaction</span><i>✺</i><span>Brand</span><i>✺</i></div>
        </div>
      </section>
