---
import { profile } from '../scripts/data.js'
---
    <!-- ============ MENU OVERLAY ============ -->
    <div class="menu" id="menu" aria-hidden="true" inert>
      <div class="menu__bg"></div>
      <div class="menu__in">
        <nav class="menu__links" aria-label="Primary">
          <a href="#work" data-i="01"><span class="mk">Work</span></a>
          <a href="#about" data-i="02"><span class="mk">About</span></a>
          <a href="#experience" data-i="03"><span class="mk">Experience</span></a>
          <a href="#stack" data-i="04"><span class="mk">Stack</span></a>
          <a href="#education" data-i="05"><span class="mk">Education</span></a>
          <a href="#certifications" data-i="06"><span class="mk">Certifications</span></a>
          <a href="#contact" data-i="07"><span class="mk">Contact</span></a>
        </nav>
        <div class="menu__side">
          <div><span class="k">Say hello</span><a href={`mailto:${profile.email}`} data-cursor="hover">{profile.email}</a></div>
          <div><span class="k">Elsewhere</span><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a> <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a> <a href={profile.resume} download>Resume</a></div>
          <div><span class="k">Focus</span><span>Software engineering, full stack, backend &amp; AI</span></div>
        </div>
      </div>
    </div>
