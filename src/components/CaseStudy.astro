---
---
    <!-- ============ CASE STUDY ============ -->
    <div class="qv" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Case study" inert>
      <div class="qv__clip">
        <button class="qv__x" type="button" aria-label="Close case study" data-cursor="hover" data-magnetic><span>Close</span><i></i></button>
        <div class="qv__scroll" data-lenis-prevent>
          <div class="qv__hero">
            <div class="qv__media"><canvas></canvas></div>
            <div class="qv__title"><span class="qv__n"></span><h3></h3><p class="qv__sum"></p></div>
          </div>
          <div class="qv__body">
            <dl class="qv__meta"><div><dt>Role</dt><dd class="qv-role"></dd></div><div><dt>Focus</dt><dd class="qv-year"></dd></div><div><dt>Tools</dt><dd class="qv-tools"></dd></div><div><dt>Deliverables</dt><dd class="qv-del"></dd></div></dl>
            <div class="qv__text">
              <p class="qv__lead qv-desc"></p>
              <section><span class="k">01 — Brief</span><p class="qv-brief"></p></section>
              <section><span class="k">02 — Challenge</span><p class="qv-challenge"></p></section>
              <section><span class="k">03 — Approach</span><p class="qv-approach"></p></section>
              <section><span class="k">04 — Result</span><p class="qv-result"></p></section>
            </div>
          </div>
          <button class="qv__next" type="button" data-cursor="hover"><span class="k">Next case</span><span class="qv__next-t"></span><i>→</i></button>
        </div>
      </div>
    </div>

    <div class="toast" role="status" aria-live="polite">Email copied</div>
