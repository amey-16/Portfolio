---
import { certifications } from '../scripts/data.js'
---
<section class="clients sec" id="certifications" data-rail="Certifications">
  <div class="clients__head"><h2 class="certifications__heading">Certifications &amp; appreciation</h2><p class="clients__note">Learning and recognition along the way.</p></div>
  <ul class="clist">
    {certifications.map((item, index) => (
      <li class="crow" data-art={index}>
        <span class="crow__n">{String(index + 1).padStart(2, '0')}</span>
        <span class="crow__name">{item.name}</span>
        <span class="crow__what">{item.detail}</span>
        <span class="crow__y">{item.initials}</span>
      </li>
    ))}
  </ul>
  <div class="peek" aria-hidden="true"><div class="peek__in"><canvas></canvas></div></div>
</section>
