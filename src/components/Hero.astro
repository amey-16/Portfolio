      <!-- ============ HERO: liquid type ============ -->
      <section class="hero sec" id="top" data-rail="Index">
        <div class="hero__pin">
          <canvas class="hero__gl" aria-hidden="true"></canvas>
          <div class="hero__top">
            <p class="kick">Product designer<br />and creative developer</p>
            <p class="kick kick--r">Based in Pune, India<br />Working worldwide</p>
          </div>
          <h1 class="hero__title" aria-label="Considered design for products people remember.">
            <span class="hero__line">Considered design</span>
            <span class="hero__line">for products people</span>
            <span class="hero__line hero__line--acc"><em>remember.</em></span>
          </h1>
          <div class="hero__bottom">
            <p class="hero__lede">I design and build digital products and websites for ambitious teams. Seven years, forty-two launches.</p>
            <a class="hero__badge" href="#work" data-magnetic data-cursor="hover" aria-label="Scroll to selected work">
              <svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id="badgeCircle" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs><text><textPath href="#badgeCircle">Scroll · Selected work · Scroll · Selected work ·</textPath></text></svg>
              <span class="hero__badge-ar">↓</span>
            </a>
          </div>
        </div>
      </section>
