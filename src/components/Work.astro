---
---
      <!-- ============ WORK: shader gallery ============ -->
      <section class="work sec sec--dark" id="work" data-rail="Work">
        <div class="work__pin">
          <canvas class="work__gl" aria-hidden="true"></canvas>
          <div class="work__frame" data-cursor="Open case" role="button" tabindex="0" aria-label="Open the current case study"></div>
          <div class="work__head">
            <p class="eyebrow">Selected work</p>
            <span class="work__count"><span class="odo" data-odo="01"></span> / 05</span>
          </div>
          <ol class="work__index" aria-label="Projects"></ol>
          <div class="work__titles" aria-live="polite"></div>
          <div class="work__meta"></div>
          <div class="work__hint" aria-hidden="true"><i></i><span>Scroll to change project</span></div>
          <div class="work__bar" aria-hidden="true"><i></i></div>
        </div>
        <ul class="work__lite"></ul>
      </section>
