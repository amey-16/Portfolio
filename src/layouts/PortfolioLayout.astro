---
import '../styles/living.css'
import '../styles/depth.css'
import Arrow from '../components/Arrow.astro'
const { title = 'Amey Shelar — Senior Full Stack Developer & AI/ML Engineer', description = 'Complex systems. Beautifully resolved. Full-stack software, applied AI and thoughtful product engineering by Amey Shelar.', interior = false } = Astro.props
const home = interior ? '/' : ''
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#F0EDE6" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80'%3E%3Crect width='80' height='80' rx='5' fill='%23581E2C'/%3E%3Cpath d='M15 63 33 17h14l18 46H51l-4-12H32l-4 12Zm21-24h7l-3-10Z' fill='%23F0EDE6'/%3E%3C/svg%3E" /><title>{title}</title></head>
<body class:list={{interior}}><a class="skip-link" href="#main">Skip to content</a><header class="exhibition-header"><a class="wordmark" href={`${home}#top`}>AMEY SHELAR<span>Full Stack / AI &amp; ML</span></a><nav aria-label="Main navigation"><a href={`${home}#work`}>Work</a><a href={`${home}#story`}>About</a><a class="extended-nav" href={`${home}#experience`}>Experience</a><a class="extended-nav" href={`${home}#stack`}>Stack</a><a href={`${home}#contact`} class="nav-contact">Contact <Arrow /></a></nav></header><slot />
<footer class="exhibition-footer"><span>Amey Shelar © {new Date().getFullYear()}</span><a href="https://github.com/amey-16" target="_blank" rel="noreferrer">GitHub <Arrow direction="up" /></a><a href="https://linkedin.com/in/amey-shelar123" target="_blank" rel="noreferrer">LinkedIn <Arrow direction="up" /></a><a class="motion-preference" href="?motion=off">Reduce motion</a><a href={`${home}#top`} class="footer-top">Back to top <Arrow direction="up" /></a></footer>
{!interior && <><div class="reading-line" aria-hidden="true"><i></i></div><nav class="chapter-nav" aria-label="Chapter navigation"><button type="button" aria-expanded="false" aria-controls="chapter-menu">Explore chapters <Arrow /></button><ol id="chapter-menu" hidden>{[['top','Opening'],['story','The person'],['architecture','The thinking'],['work','Selected work'],['vision','Applied intelligence'],['experience','Experience'],['stack','Stack'],['scope','Your product'],['collaborate','Collaboration'],['contact','Next chapter']].map(([id,name],i)=><li><a href={`#${id}`}><span>{String(i+1).padStart(2,'0')}</span>{name}</a></li>)}</ol></nav></>}
<script>import '../scripts/living.js'</script></body></html>
